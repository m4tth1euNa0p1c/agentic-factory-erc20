{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Grep(./**/.env)",
      "Read(./**/.env.development)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Read(./**/.env.local)",
      "Read(./**/.env)",
      "Read(./infra/.secrets/**)",
      "Edit(./infra/.secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose cp:*)"
    ],
    "allow": [
      "Bash(scripts/sandbox.sh:*)",
      "Bash(scripts/forge.sh:*)",
      "Bash(scripts/slither.sh:*)",
      "Bash(tests/e2e/run.sh:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose stop:*)",
      "Bash(docker compose start:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
