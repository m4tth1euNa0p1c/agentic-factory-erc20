{
  "name": "@tela/adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TELA blockchain adapter: Kafka commands -> Web3Signer (eth_signTransaction) -> Besu, with crash-safe tx journal (spec 002)",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.11.0",
    "pg": "8.23.1",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
